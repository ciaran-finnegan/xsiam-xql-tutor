{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "xql-tutor",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-20",
  // The Cloudflare account that owns the riskscope-consulting.com zone. Change this if you fork and host elsewhere.
  "account_id": "6a9e4591f2bb3711c87592659eeee480",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "xql-tutor.riskscope-consulting.com", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "xql-tutor", "database_id": "d98ca81f-3c0e-412c-91a6-e1e7ecdccdd4" }],
  "vars": {
    "APP_ORIGIN": "https://xql-tutor.riskscope-consulting.com",
    // Email one-time codes are sent through Resend (secret RESEND_API_KEY) from this address on a verified domain.
    "EMAIL_FROM": "no-reply@riskscope-consulting.com",
    // OAuth client ids are public by design; the matching *_CLIENT_SECRET values are Worker secrets.
    "GITHUB_CLIENT_ID": "Ov23li0l1wns136PN82a",
    "MICROSOFT_CLIENT_ID": "af7614de-8755-426e-b6a4-a4ae28161219",
    "GOOGLE_CLIENT_ID": "1054436603632-jtestlb7rj630gtfe37hua2j5ki1j97a.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
